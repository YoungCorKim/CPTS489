<!-- The Basic GUI Design For Our Website -->

<!DOCTYPE html>
<html lang="eng">
    <head>
        <link rel="stylesheet" href="/style.css" text="text/css">
    </head>

    <body>
        <div id="mainLayout">
            <!-- This is the Side Navbar -->
            <div id="sidebar">
                <div id="navSpace">
                    <!-- Replace This With an Icon Eventually... ? -->
                </div>
                <button class="sideButton" onclick="location.href='/'">
                    Home
                </button>
                <button class="sideButton" onclick="location.href='/login'">
                    Login
                </button>
                <button class="sideButton" onclick="location.href='/calendar'">
                    Calendars
                </button>
                <!-- These Will Need to Be Professor Only Eventually -->
                <button class="sideButton" onclick="location.href='/class/create'">
                    Create Class
                </button>
                <button class="sideButton" onclick="location.href='/class/manage'">
                    Manage Classes
                </button>
                <!-- These Will Only Be A Student View Eventually -->
                <button class="sideButton" onclick="location.href='/event/create'">
                    Create Event
                </button>
                <button class="sideButton" onclick="location.href='/event/manage'">
                    Manage Events
                </button>
                <button class="sideButton" onclick="location.href='/import'">
                    Import Schedule
                </button>
                <button class="sideButton" onclick="location.href='/groups'">
                    Groups
                </button>
                <!-- Utilities For Everyone -->
                <button class="sideButton" onclick="location.href='/finduser'">
                    Find User
                </button>
                <button class="sideButton" onclick="location.href='/settings'">
                    Settings
                </button>
                <button class="sideButton" action="/logout">
                    Log Out
                </button>
            </div>

            <!-- Utilities -->
            <div class="tab" id="findUser">
                <div>
                    <div id="userSearchText" class="p boldFont">
                        Search For a User Below
                    </div>
                    <form id="searchUsers" method="POST" action="/find">
                        <input type="text" class="textBar searchBar" id="userSearchBar" placeholder="Enter a Username">
                        <button id="searchUserButton" type="submit">Search</button>
                    </form>
                </div>
                <!-- Table for Results -->
                <table id="responses">
                    <tr>
                        <th>Name</th>
                        <th>Role</th>
                    </tr>

                    <!-- Loop Through the Users in SQL To Fill Table -->
                    <% users.forEach(user => { %>
                        <tr>
                            <td><%= user.name %></td>
                            <td><%= user.type %></td>
                        </tr>
                    <% }); %>
                </table>
            </div>

        <!-- Link to JavaScript Code -->
         <script src="/Website.js"></script>
    </body>
</html>