<!-- The Basic GUI Design For Our Website -->

<!DOCTYPE html>
<html lang="eng">
    <head>
        <link rel="stylesheet" href="/style.css" text="text/css">
    </head>

    <body>
        <div id="mainLayout">
            <!-- This is the Side Navbar -->
            <div id="sidebar">
                <div id="navSpace">
                    <!-- Replace This With an Icon Eventually... ? -->
                </div>
                <button class="sideButton" onclick="location.href='/'">
                    Home
                </button>
                <button class="sideButton" onclick="location.href='/login'">
                    Login
                </button>
                <button class="sideButton" onclick="location.href='/calendar'">
                    Calendars
                </button>
                <!-- These Will Only Be A Student View Eventually -->
                <button class="sideButton" onclick="location.href='/event/create'">
                    Create Event
                </button>
                <button class="sideButton" onclick="location.href='/event/manage'">
                    Manage Events
                </button>
                <button class="sideButton" onclick="location.href='/import'">
                    Import Schedule
                </button>
                <button class="sideButton" onclick="location.href='/groups'">
                    Groups
                </button>
                <!-- Utilities For Everyone -->
                <button class="sideButton" onclick="location.href='/finduser'">
                    Find User
                </button>
                <button class="sideButton" onclick="location.href='/settings'">
                    Settings
                </button>
                <button class="sideButton" action="/logout">
                    Log Out
                </button>
            </div>
            <!-- Each Of These is a Tab and Is Set to None Display So It Is Hidden -->

            <div class="tab" id="importSched">
                <h2 class="importTitle">Import Schedule</h2>
                <div class="formContainer">
                <div class="formGroup">
                    <label for="csvUpload">Upload CSV File</label>
                    <input type="file" id="csvUpload" accept=".csv" class="textBar">
                </div>

                <button class="sideButton" id="uploadButton">Upload</button>
                <p id="uploadStatus"></p>

                <p style="font-size: 11px; color: gray">
                    Format: <code>Title,StartDate,EndDate,Location</code>
                </p>
                </div>
            </div>

        <!-- Link to JavaScript Code -->
         <script src="Website.js"></script>
    </body>
</html>