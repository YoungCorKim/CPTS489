<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="stylesheet" href="/style.css" type="text/css">
    <title>Import Schedule</title>
</head>
<body>
    <div id="mainLayout">
        <!-- Sidebar Navigation -->
        <div id="sidebar">
            <button class="sideButton" onclick="location.href='/home'">Home</button>
            <button class="sideButton" onclick="location.href='/calendar/view'">Calendars</button>
            <button class="sideButton" onclick="location.href='/event/create'">Create Event</button>
            <button class="sideButton" onclick="location.href='/event/manage'">Manage Events</button>
            <button class="sideButton" onclick="location.href='/import'">Import Schedule</button>
            <button class="sideButton" onclick="location.href='/groups'">Groups</button>
            <button class="sideButton" onclick="location.href='/finduser'">Find User</button>
            <button class="sideButton" onclick="location.href='/settings'">Settings</button>
            <button class="sideButton" onclick="location.href='/'">Log Out</button>
        </div>

        <!-- Schedule Import Form -->
        <div class="tab" id="importSched">
            <h2 class="importTitle">Import Schedule</h2>

            <% if (typeof message !== 'undefined') { %>
                <p style="color: <%= success ? 'green' : 'red' %>;"><%= message %></p>
            <% } %>

            <form action="/import" method="POST" enctype="multipart/form-data" class="formContainer">
                <div class="formGroup">
                    <label for="scheduleFile">Upload CSV File</label>
                    <input type="file" id="scheduleFile" name="scheduleFile" accept=".csv,.txt" class="textBar" required>
                </div>
                <button class="sideButton" type="submit">Upload</button>
                <p style="font-size: 11px; color: gray">
                    Format: <code>userId,date,time,event</code>
                </p>
            </form>
        </div>
    </div>
</body>
</html>

