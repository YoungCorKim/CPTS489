<!-- The Basic GUI Design For Our Website -->

<!DOCTYPE html>
<html lang="eng">
    <head>
        <link rel="stylesheet" href="/style.css" text="text/css">
    </head>

    <body>
        <div id="mainLayout">
            <!-- This is the Side Navbar -->
            <div id="sidebar">
                <div id="navSpace">
                    <!-- Replace This With an Icon Eventually... ? -->
                </div>
                <button class="sideButton" onclick="location.href='/'">
                    Home
                </button>
                <button class="sideButton" onclick="location.href='/login'">
                    Login
                </button>
                <button class="sideButton" onclick="location.href='/register'">
                    Register
                </button>
            </div>
            <!-- Each Of These is a Tab and Is Set to None Display So It Is Hidden -->

            <!-- Main Tabs -->
            <div class="tab" id="login">

                <form id="login" method="POST" action="/logincheck">
                    <div>
                        <div class="p boldFont">
                            Enter Your Username or Email
                        </div>
                        <input type="text" class="textBar loginBar" id="username" name="username" required>
                        <div class="p boldFont">
                            Enter Your Password
                        </div>
                        <!-- Type Password Makes It * -->
                        <input type="password" class="textBar loginBar" id="password" name="password" required>
                        <div>
                            <!-- Show/Hide Password Toggle -->
                            <input type="checkbox" id="passwordToggle" onchange="passwordToggle()">
                            <label for="passwordToggle">Show Password</label>
                        </div>

                    </div>
                    <button class="loginButton" type="submit">
                        Login
                    </button>
                </form>
                    <div class="p smallFont">
                        Don't have an account? Sign up
                        <button class="registerButton" onclick="location.href='/register'">
                            here
                        </button>
                    </div>
                </div>
            </div>

        <!-- Link to JavaScript Code -->
         <script src="Website.js" defer></script>
    </body>
</html>