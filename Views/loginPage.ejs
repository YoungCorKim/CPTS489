<!-- The Basic GUI Design For Our Website -->

<!DOCTYPE html>
<html lang="eng">
    <head>
        <link rel="stylesheet" href="/style.css" text="text/css">
    </head>

    <body>
        <div id="mainLayout">
            <!-- This is the Side Navbar -->
            <div id="sidebar">
                <div id="navSpace">
                    <!-- Replace This With an Icon Eventually... ? -->
                </div>
                <button class="sideButton" action="/main">
                    Home
                </button>
                <button class="sideButton" action="/login">
                    Login
                </button>
                <button class="sideButton" action="/calendar">
                    Calendars
                </button>
                <!-- These Will Need to Be Professor Only Eventually -->
                <button class="sideButton" action="/createclass">
                    Create Class
                </button>
                <button class="sideButton" action="/manageclass">
                    Manage Classes
                </button>
                <!-- These Will Only Be A Student View Eventually -->
                <button class="sideButton" action="/createevent">
                    Create Event
                </button>
                <button class="sideButton" action="/manageevent">
                    Manage Events
                </button>
                <button class="sideButton" action="/import">
                    Import Schedule
                </button>
                <button class="sideButton" action="/groups">
                    Groups
                </button>
                <!-- Utilities For Everyone -->
                <button class="sideButton" action="/finduser">
                    Find User
                </button>
                <button class="sideButton" action="/settings">
                    Settings
                </button>
            </div>
            <!-- Each Of These is a Tab and Is Set to None Display So It Is Hidden -->

            <!-- Main Tabs -->
            <div class="tab" id="login">
                <div>
                    <div class="p boldFont">
                        Enter Your Username or Email
                    </div>
                    <input type="text" class="textBar loginBar" id="username">
                    <div class="p boldFont">
                        Enter Your Password
                    </div>
                    <!-- Type Password Makes It * -->
                    <input type="password" class="textBar loginBar" id="password">
                    <div>
                        <!-- Show/Hide Password Toggle -->
                        <input type="checkbox" id="passwordToggle" onchange="passwordToggle()">
                        <label for="passwordToggle">Show Password</label>
                    </div>
                    <!-- Login Error Text -->
                    <div id="loginErrorText" style="display: none;"></div>
                </div>
                <button id="loginButton" onclick="loginCheck()">
                        Login
                </button>
            </div>

        <!-- Link to JavaScript Code -->
         <script src="Website.js"></script>
    </body>
</html>