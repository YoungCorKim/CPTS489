<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="stylesheet" href="/style.css" type="text/css">
</head>
<body>
    <div id="mainLayout">
        <!-- Sidebar -->
        <div id="sidebar">
            <div id="navSpace"></div>
            <button class="sideButton" onclick="location.href='/'">Home</button>
            <button class="sideButton" onclick="location.href='/calendar'">Calendars</button>
            <button class="sideButton" onclick="location.href='/class/create'">Create Class</button>
            <button class="sideButton" onclick="location.href='/class/manage'">Manage Classes</button>
            <button class="sideButton" onclick="location.href='/event/create'">Create Event</button>
            <button class="sideButton" onclick="location.href='/event/manage'">Manage Events</button>
            <button class="sideButton" onclick="location.href='/import'">Import Schedule</button>
            <button class="sideButton" onclick="location.href='/groups'">Groups</button>
            <button class="sideButton" onclick="location.href='/finduser'">Find User</button>
            <button class="sideButton" onclick="location.href='/settings'">Settings</button>
            <button class="sideButton" onclick="location.href='/'">Log Out</button>
        </div>

        <!-- Main Content -->
        <div class="tab" id="home">
            <!-- Events Today -->
            <div id="eventsToday">
                <div id="eventTitle">Today's Events</div>
                <div class="eventText">Event 1</div>
                <div class="eventText">Event 2</div>
                <div class="eventText">Event 3</div>
            </div>

            <!-- Notifications -->
            <div id="homeNotifications">
                <div id="notificationTitle">Notifications</div>
                <div class="notification">
                    <span>Notification 1</span>
                    <button class="dismiss-btn">Dismiss</button>
                </div>
                <div class="notification">
                    <span>Notification 2</span>
                    <button class="dismiss-btn">Dismiss</button>
                </div>
                <div class="notification">
                    <span>Notification 3</span>
                    <button class="dismiss-btn">Dismiss</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Script -->
    <script src="/Website.js"></script>
</body>
</html>
