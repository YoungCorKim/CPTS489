<!-- The Basic GUI Design For Our Website -->

<!DOCTYPE html>
<html lang="eng">
    <head>
        <link rel="stylesheet" href="/style.css" text="text/css">
    </head>

    <body>
        <div id="mainLayout">
            <!-- This is the Side Navbar -->
            <div id="sidebar">
                <div id="navSpace">
                    <!-- Replace This With an Icon Eventually... ? -->
                </div>
                <button class="sideButton" onclick="location.href='/'">
                    Home
                </button>
                <button class="sideButton" onclick="location.href='/login'">
                    Login
                </button>
                <button class="sideButton" onclick="location.href='/register'">
                    Register
                </button>
                <button class="sideButton" onclick="location.href='/calendar'">
                    Calendars
                </button>
                <!-- These Will Need to Be Professor Only Eventually -->
                <button class="sideButton" onclick="location.href='/class/create'">
                    Create Class
                </button>
                <button class="sideButton" onclick="location.href='/class/manage'">
                    Manage Classes
                </button>
                <!-- These Will Only Be A Student View Eventually -->
                <button class="sideButton" onclick="location.href='/event/create'">
                    Create Event
                </button>
                <button class="sideButton" onclick="location.href='/event/manage'">
                    Manage Events
                </button>
                <button class="sideButton" onclick="location.href='/import'">
                    Import Schedule
                </button>
                <button class="sideButton" onclick="location.href='/groups'">
                    Groups
                </button>
                <!-- Utilities For Everyone -->
                <button class="sideButton" onclick="location.href='/finduser'">
                    Find User
                </button>
                <button class="sideButton" onclick="location.href='/settings'">
                    Settings
                </button>
            </div>
            <!-- Each Of These is a Tab and Is Set to None Display So It Is Hidden -->

            <!-- Registration Tab -->
            <div class="tab" id="register">
                <div>
                    <div class="p boldFont">
                        Enter Your Email
                    </div>
                    <input type="text" class="textBar loginBar" id="emailReg">
                    <div class="p boldFont">
                        Enter a Username
                    </div>
                    <input type="text" class="textBar loginBar" id="usernameReg">
                    <!-- Username Taken Error Text -->
                    <div id="usernameTakenError" style="display: none;"></div>
                    <div class="p boldFont">
                        Enter Your Password
                    </div>
                    <input type="text" class="textBar loginBar" id="passwordReg1">
                    <div class="p boldFont">
                        Confirm Your Password
                    </div>
                    <input type="text" class="textBar loginBar" id="passwordReg2">
                    <!-- Password Mismatch Error Text -->
                    <div id="passwordMismatchError" style="display: none;"></div>
                </div>
                <button class="loginButton" onclick="signUpCheck()">
                        Sign Up
                </button>
                <div>
            </div>

        <!-- Link to JavaScript Code -->
         <script src="register.js"></script>
    </body>
</html>